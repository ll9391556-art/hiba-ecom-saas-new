{
  "rules": {
    ".read": false,
    ".write": false,
    "data": {
      "$uid": {
        "orders": { ".indexOn": ["createdAt", "updatedAt", "phoneDigits"] },
        "deletedOrders": { ".indexOn": ["at"] }
      }
    },
    "conversations_meta": {
      "$uid": { ".indexOn": ["lastTimestamp"] }
    },
    "support_tickets": { ".indexOn": ["uid"] },
    "bot_logs": {
      "$uid": { ".indexOn": ["timestamp"] }
    }
  }
}
